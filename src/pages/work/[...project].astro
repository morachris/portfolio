---
import Layout from '../../layouts/Layout.astro';
import OverlayBorder from '../../components/OverlayBorder';
import ProjectInstance from '../../components/ProjectInstance';
import Navigation from '../../components/Navigation';
import Footer from '../../components/Footer';

import Auto1 from '../../assets/project-images/automation/automation-1.jpeg';
import Auto2 from '../../assets/project-images/automation/automation-2.jpeg';
import Auto3 from '../../assets/project-images/automation/automation-3.jpeg';
import Auto4 from '../../assets/project-images/automation/automation-4.jpeg';

import Glint1 from '../../assets/project-images/glint/glint-1.jpeg';
import Glint2 from '../../assets/project-images/glint/glint-2.jpeg';
import Glint3 from '../../assets/project-images/glint/glint-3.jpeg';
import Glint4 from '../../assets/project-images/glint/glint-4.jpeg';

import type { MarkdownInstance } from 'astro';

export async function getStaticPaths() {
  const mdFiles = await Astro.glob('../../content/*.md');
  const glintContent: MarkdownInstance<any> = mdFiles.find((glint) => glint.file.includes('glint.md'))!;
  const automationContent: MarkdownInstance<any> = mdFiles.find((auto) => auto.file.includes('automation.md'))!;
  const lumidirContent: MarkdownInstance<any> = mdFiles.find((lumidir) => lumidir.file.includes('lumidir.md'))!;
  const glintHTML = await glintContent.compiledContent();
  const automationHTML = await automationContent.compiledContent();
  const lumidirHTML = await lumidirContent.compiledContent();

  const projects: any[] = [
    {
      slug: 'lumidir-habits',
      title: 'Lumidir Habits',
      description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
      specs: {
        date: 'December 2025 - Present',
        type: 'Personal Web Application',
      },
      markdownContent: lumidirHTML,
      images: [
        '../../assets/project-images/lumidir-habits-1.png',
        '../../assets/project-images/lumidir-habits-2.png',
        '../../assets/project-images/lumidir-habits-3.png',
      ],
    },
    { 
      slug: 'automation-project',
      title: 'Automation Project',
      description: `This project is a purely academic automation and educational web application designed to support students in understanding the fundamental concepts of Object-Oriented Programming (OOP).
      
      Its primary goal is to reduce learning barriers by combining structured theoretical content with hands-on practical exercises. 
      
      The application was specifically developed for fifth-year students in the Web Development program at Don Bosco Technical Professional High School and was not intended for commercial use or production environments.`,
      specs: {
        date: 'April 2025 - August 2025',
        type: 'Academic Web Application',
      },
      markdownContent: automationHTML,
      images: [
        Auto1,
        Auto2,
        Auto3,
        Auto4,
      ],
    },
    {
      slug: 'glint',
      title: 'Glint',
      description: `
        Glint is a productivity-focused task management application developed as an academic/personal designed to help organize work efficiently through structured workspaces and an integrated notes system.
        
        The primary goal of the project is to provide a clean, intuitive environment to manage tasks and group them by context, as well as making use of the services Microsoft Azure provides.
      `,
      specs: {
        date: 'March 2025 - July 2025',
        type: 'Personal Web Application',
      },
      markdownContent: glintHTML,
      images: [
        Glint1,
        Glint2,
        Glint3,
        Glint4,
      ],
    },
  ]

  return projects.map(({ slug, title, description, specs, markdownContent, images }) => {
    return {
      params: { project: slug },
      props: { title, description, specs, markdownContent, images },
    };
  })
}

const { title, description, specs, markdownContent, images } = Astro.props;

---
<Layout>
  <OverlayBorder />
  <div class="main-wrapper">
    <ProjectInstance 
      title={title} 
      description={description}
      specs={specs}
      markdownContent={markdownContent}
      images={images}
      client:load />
    <Navigation client:load />
  </div>
  <Footer client:load />
</Layout>

<style>
  .main-wrapper {
    background-image: url('../../assets/background-dark.png');
    background-color: #010007;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
</style>
